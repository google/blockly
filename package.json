{
  "name": "blockthreed",
  "version": "0.0.0",
  "description": "BlockThreed \u2014 a Scratch-like 3D game engine with block coding (Blockly fork)",
  "keywords": [
    "blockthreed",
    "blockly",
    "three.js",
    "game-engine",
    "visual-programming"
  ],
  "homepage": "https://github.com/Flakween/BlockThreed",
  "bugs": {
    "url": "https://github.com/Flakween/BlockThreed/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flakween/BlockThreed.git"
  },
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/plugins/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@nx/js": "23.1.1",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "10.10.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-mocha": "^12.0.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "lerna": "^10.0.1",
    "nx": "23.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript-eslint": "^8.66.0"
  },
  "scripts": {
    "test": "npx nx run-many -t test --exclude=blockly && npx nx run blockly:test",
    "lint": "npm run lint --ws --if-present",
    "lint-fix": "npm run lint-fix --ws --if-present",
    "build": "npx nx run-many -t build",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "clean": "npx nx reset && npm run clean --ws --if-present"
  },
  "dependencies": {}
}
